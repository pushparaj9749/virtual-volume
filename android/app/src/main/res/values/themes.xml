<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      The window theme only exists to paint the launch window before Compose takes over.
      Virtual Volume is dark-first; the in-app light theme is applied by Compose.
    -->
    <style name="Theme.VirtualVolume" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:colorBackground">@color/window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
