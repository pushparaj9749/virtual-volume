# --- Android / Gradle ---
android/.gradle/
android/build/
android/app/build/
android/app/release/
android/captures/
android/.kotlin/
*.apk
*.aab
*.ap_
*.dex
*.class

# Local signing material — never commit these
android/keystore.properties
android/app/*.jks
android/app/*.keystore
*.jks
*.keystore

# Local configuration
local.properties

# --- IDE ---
.idea/
*.iml
.DS_Store
captures/
.externalNativeBuild/
.cxx/

# --- Website ---
website/node_modules/
website/dist/

# --- Logs / temp ---
*.log
*.tmp

# Local QA/downloaded artifacts (never source)
.qa/
.artifacts/
.toolchain/
**/test-results/
website/playwright-report/
website/.test-output/
website/.pages/
# Encrypted or encoded signing backups are still sensitive
*keystore*.base64
*keystore*.b64
# The official Gradle wrapper is required build tooling, not an app binary
!android/gradle/wrapper/gradle-wrapper.jar
